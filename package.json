{
  "name": "proyecto-final-portafolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project backend/tsconfig.json backend/src/server.ts",
    "start": "node backend/dist/server.js",
    "frontend": "node frontend/server.js",
    "build": "tsc --project backend/tsconfig.json",
    "test": "npm run build && node --test backend/tests/domain-validation.test.js backend/tests/api.integration.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
